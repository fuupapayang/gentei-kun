rules_version = '2';
// 限定くん — Firestore rules for the serverless (Firebase Spark) deploy.
// firestore.rules is GENERATED from this template:  node scripts/make-rules.js admin1@example.com,admin2@example.com
// Roles:  admin    = Firebase email/password user whose (lower-cased) e-mail is in the list below  -> full access
//         customer = Firebase anonymous-auth user (uid) -> only the narrow rights spelled out here
// Everything not explicitly allowed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && ('email' in request.auth.token) && request.auth.token.email.lower() in __ADMIN_EMAILS__;
    }
    function isCustomer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // admin: everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // public information (shown on the registration page / sales tool before sign-in)
    match /property/{id} {
      allow get: if true;
    }
    match /settings/public {          // {vapidPublicKey} only. NEVER store private keys in Firestore.
      allow get: if true;
    }

    // library: customers may only list/read ACTIVE items (the app queries where active == true; tag filtering is client-side)
    match /contents/{id} {
      allow read: if isCustomer() && resource.data.active == true;
    }

    // push history: only already-sent pushes (query where status == 'sent'); status queued/draft stay admin-only
    match /pushes/{id} {
      allow read: if isCustomer() && resource.data.status == 'sent';
    }

    // personal files: only the customer's own (query where customerId == uid)
    match /personalFiles/{id} {
      allow read: if isCustomer() && resource.data.customerId == request.auth.uid;
    }

    // customer profile: doc id == anonymous uid
    match /customers/{uid} {
      allow get: if isCustomer() && request.auth.uid == uid;

      allow create: if isCustomer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'tags', 'status', 'assignee', 'memo', 'createdAt', 'lastSeenAt', 'pushSub', 'installed', 'platform'])
        && request.resource.data.keys().hasAll(['name', 'email', 'tags', 'status', 'assignee', 'memo'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 10      // self-declared campaign tags at sign-up only (same as the Express version)
        && request.resource.data.status == '新規'
        && request.resource.data.assignee == ''
        && request.resource.data.memo == ''
        && request.resource.data.get('pushSub', null) == null
        && request.resource.data.get('installed', false) == false
        && request.resource.data.get('platform', 'pc') == 'pc';

      // customers can never touch tags / status / assignee / memo / createdAt afterwards
      allow update: if isCustomer() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'lastSeenAt', 'pushSub', 'installed', 'platform'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.installed is bool
        && request.resource.data.platform in ['ios', 'android', 'pc']
        && (request.resource.data.pushSub == null || request.resource.data.pushSub is map);
    }

    // behaviour log: customers may only append their own events
    match /events/{id} {
      allow create: if isCustomer()
        && request.resource.data.keys().hasOnly(['customerId', 'type', 'target', 'at'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.type in ['login', 'page', 'content', 'push_open', 'install', 'vr', 'library']
        && request.resource.data.target is string && request.resource.data.target.size() <= 300
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
    }

    // tags, conversions, anything else: admin only (global rule above)
  }
}
